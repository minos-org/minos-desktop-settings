//This file is part of the minos-desktop-settings package

polkit.addRule(function(action, subject) {
    if (/^org\.freedesktop\.udisks2\.(filesystem-mount(-system)?|filesystem-unmount-others|eject-media(-system)?|power-off-drive(-system)?|encrypted-unlock(-system)?)$/.test(action.id) &&
        subject.local && subject.active && subject.isInGroup("sudo")) {
        return polkit.Result.YES;
    }
});
